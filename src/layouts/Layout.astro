---
// 根布局：SEO meta、结构化数据、Header/Footer/WhatsApp/询盘购物车
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import InquiryCart from '../components/InquiryCart.astro';
import { SITE } from '../consts';
import { getLocaleFromUrl, getHtmlLang, t, type Locale } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, locale, image, noindex = false, schema } = Astro.props;
const currentLocale: Locale = locale || getLocaleFromUrl(Astro.url);
const htmlLang = getHtmlLang(currentLocale);
const pageTitle = title || t(currentLocale, 'nav.home') + ' · ' + SITE.brand;
const pageDescription = description || SITE.description;
const siteUrl = Astro.site ?? SITE.url;
const canonical = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL(image || SITE.defaultOgImage, siteUrl);
const pathWithoutLocale = Astro.url.pathname.replace(/^\/zh(\/|$)/, '/').replace(/^\/zh$/, '/');
const enUrl = new URL(pathWithoutLocale === '/' ? '/' : pathWithoutLocale, siteUrl);
const zhUrl = new URL('/zh' + (pathWithoutLocale === '/' ? '' : pathWithoutLocale), siteUrl);
const jsonLd = schema ? (Array.isArray(schema) ? schema : [schema]) : null;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:locale" content={currentLocale === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&family=Quicksand:wght@500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {jsonLd?.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body class="min-h-screen flex flex-col">
    <Header locale={currentLocale} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={currentLocale} />
    <WhatsAppButton locale={currentLocale} />
    <InquiryCart locale={currentLocale} />
  </body>
</html>
