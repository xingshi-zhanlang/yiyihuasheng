---
// 博客首页：SEO 内容占位结构
import Layout from '../../layouts/Layout.astro';
import { t, getLocalePath, type Locale } from '../../i18n/utils';

const locale: Locale = 'en';
const basePath = getLocalePath(locale);

// 占位文章结构（后续可填充真实内容）
const posts = [
  {
    title: 'How to Choose the Right Pet Carrier for Air Travel',
    excerpt:
      'A practical guide to airline-approved pet carriers — sizing, ventilation, materials and what to look for when sourcing wholesale.',
    tag: 'Sourcing Guide',
    date: 'Coming soon',
  },
  {
    title: 'RPET Fabric: Why Recycled Materials Are the Future of Pet Gear',
    excerpt:
      'Inside the Valley Series — how RPET recycled fabric performs, its sustainability benefits and why buyers care.',
    tag: 'Materials',
    date: 'Coming soon',
  },
  {
    title: 'OEM vs ODM: What Pet Brands Need to Know',
    excerpt:
      'The difference between OEM and ODM, and how to pick the right manufacturing model for your private-label pet line.',
    tag: 'Business',
    date: 'Coming soon',
  },
];
---

<Layout
  locale="en"
  title="Blog — HiDREAM® Pet Travel Gear Insights | Wholesale & OEM/ODM"
  description="Sourcing guides, material insights and B2B tips for pet travel gear from HiDREAM®. Learn about carriers, harnesses, RPET and OEM/ODM."
>
  <section class="border-b border-milk-tea/60 bg-milk-tea/20">
    <div class="mx-auto max-w-7xl px-4 py-12 md:px-8 md:py-16">
      <nav class="text-xs text-stone" aria-label="Breadcrumb">
        <a href={`${basePath}/`} class="hover:text-olive-dark">{t(locale, 'nav.home')}</a>
        <span class="mx-1.5">/</span>
        <span class="text-dark-brown">{t(locale, 'nav.blog')}</span>
      </nav>
      <h1 class="mt-3 font-display text-3xl font-bold text-dark-brown md:text-4xl lg:text-5xl">
        {t(locale, 'blog.title')}
      </h1>
      <p class="mt-3 max-w-2xl text-stone">
        {t(locale, 'blog.subtitle')}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12 md:px-8 md:py-16">
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((p) => (
          <article class="group flex flex-col overflow-hidden rounded-3xl border border-milk-tea/50 bg-white/70 shadow-card transition-all hover:-translate-y-1 hover:shadow-hover">
            <div class="aspect-[16/10] overflow-hidden bg-milk-tea/30">
              <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-olive/10 to-caramel/10">
                <svg class="h-12 w-12 text-olive/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              </div>
            </div>
            <div class="flex flex-1 flex-col p-6">
              <div class="flex items-center gap-2 text-xs">
                <span class="rounded-full bg-olive/10 px-2.5 py-0.5 font-semibold text-olive-dark">{p.tag}</span>
                <span class="text-stone">{p.date}</span>
              </div>
              <h2 class="mt-3 font-display text-lg font-semibold leading-snug text-dark-brown group-hover:text-olive">
                {p.title}
              </h2>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-stone">{p.excerpt}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-caramel">
                Coming soon
              </span>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-12 rounded-[2rem] border border-dashed border-milk-tea bg-milk-tea/20 p-8 text-center">
      <p class="font-display text-lg font-semibold text-dark-brown">
        Looking for product information instead?
      </p>
      <p class="mt-1 text-sm text-stone">
        Browse our full catalog or send a wholesale inquiry directly.
      </p>
      <div class="mt-4 flex flex-wrap justify-center gap-3">
        <a href={`${basePath}/products`} class="rounded-full bg-olive px-6 py-3 text-sm font-semibold text-cream transition-colors hover:bg-olive-dark">{t(locale, 'action.browseProducts')}</a>
        <a href={`${basePath}/contact`} class="rounded-full border border-milk-tea bg-cream px-6 py-3 text-sm font-semibold text-dark-brown transition-colors hover:border-olive hover:text-olive-dark">{t(locale, 'nav.contact')}</a>
      </div>
    </div>
  </section>
</Layout>
