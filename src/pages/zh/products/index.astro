---
import Layout from '../../../layouts/Layout.astro';
import CategoryNav from '../../../components/CategoryNav.astro';
import ProductGrid from '../../../components/ProductGrid.astro';
import { getPublicProducts } from '../../../lib/catalog';
import { CATEGORIES } from '../../../consts';
import { t, getLocalePath, type Locale } from '../../../i18n/utils';

const locale: Locale = 'zh';
const basePath = getLocalePath(locale);
const env = (Astro.locals.runtime?.env || {}) as { DB?: D1Database };
const products = (await getPublicProducts(env)).filter((p) => p.variants.length > 0);
const cats = CATEGORIES;
---

<Layout locale="zh" title={`全部产品 — HiDREAM® 宠生几何 | 宠物出行用品批发`} description="浏览 HiDREAM 完整产品目录——宠物外出包、胸背牵引、出行配件和功能产品。批发 & OEM/ODM。">
  <section class="border-b border-milk-tea/60 bg-milk-tea/20"><div class="mx-auto max-w-7xl px-4 py-12 md:px-8 md:py-16"><nav class="text-xs text-stone" aria-label="Breadcrumb"><a href={`${basePath}/`} class="hover:text-olive-dark">{t(locale, 'nav.home')}</a><span class="mx-1.5">/</span><span class="text-dark-brown">{t(locale, 'nav.products')}</span></nav><h1 class="mt-3 font-display text-3xl font-bold text-dark-brown md:text-4xl lg:text-5xl">{t(locale, 'productsPage.allTitle')}</h1><p class="mt-3 max-w-2xl text-stone">{t(locale, 'productsPage.countDesc', { products: String(products.length), cats: String(cats.length) })}</p></div></section>
  <section class="mx-auto max-w-7xl px-4 py-10 md:px-8 md:py-14"><div class="sticky top-[72px] z-30 -mx-4 mb-8 bg-cream/85 px-4 py-3 backdrop-blur md:mx-0 md:rounded-2xl md:px-4"><CategoryNav showAll={false} /></div><ProductGrid products={products} eager={true} locale={locale} /></section>
</Layout>
