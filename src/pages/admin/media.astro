<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>HiDREAM Media Admin</title></head>
<body style="margin:0;background:#f5f6f8;font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#171717"><main style="max-width:760px;margin:auto;padding:40px 20px"><a href="/admin" style="color:#4b5563">← Back to Admin</a><section style="margin-top:20px;background:#fff;border:1px solid #e5e7eb;border-radius:16px;padding:24px"><h1 style="margin:0 0 8px">Media Upload</h1><p style="color:#6b7280">Free mode: images are committed to GitHub Static Assets. Recommended max size is 1 MB.</p><input id="file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" style="display:block;margin:22px 0"/><button id="upload" style="padding:11px 16px;border:0;border-radius:9px;background:#111827;color:#fff;font-weight:700">Upload</button><div id="msg" style="margin-top:14px;min-height:22px"></div><label style="display:block;font-size:12px;font-weight:700;margin:22px 0 5px">Published path</label><input id="url" readonly style="width:100%;box-sizing:border-box;padding:10px;border:1px solid #d1d5db;border-radius:8px"/></section></main><script>
// @ts-nocheck
const fileEl=document.getElementById('file'),upload=document.getElementById('upload'),msg=document.getElementById('msg'),url=document.getElementById('url');
function b64(file){return new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(String(r.result).split(',')[1]);r.onerror=reject;r.readAsDataURL(file);});}
upload.onclick=async()=>{msg.textContent='Uploading…';const file=fileEl.files?.[0];if(!file){msg.textContent='Choose an image first.';return;}if(file.size>1024*1024){msg.textContent='Keep images under 1 MB for free GitHub publishing.';return;}const r=await fetch('/api/admin/media',{method:'POST',credentials:'same-origin',headers:{'content-type':'application/json','X-Admin-Request':'1'},body:JSON.stringify({filename:file.name,contentBase64:await b64(file)})});const d=await r.json();if(!r.ok){msg.textContent=d.error||'Upload failed.';return;}msg.textContent='Uploaded.';url.value=d.url;};
</script></body></html>
