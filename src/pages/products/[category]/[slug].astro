---
// 产品详情页：运行时读取 EmDash D1，支持后台修改后立即生效
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import ProductGrid from '../../../components/ProductGrid.astro';
import { getLiveProductBySlug, getLiveProductsByCategory, getLiveProductName } from '../../../lib/live-products';
import { CATEGORIES, CONTACT } from '../../../consts';
import { t, getLocalePath, getCategoryName, type Locale } from '../../../i18n/utils';

const { category, slug } = Astro.params;
const product = category && slug ? await getLiveProductBySlug(category, slug) : undefined;
if (!product) return new Response(null, { status: 404 });

const cat = CATEGORIES.find((c) => c.slug === category);
if (!cat) return new Response(null, { status: 404 });

const related = (await getLiveProductsByCategory(category!))
  .filter((p) => p.slug !== product.slug)
  .slice(0, 4);

const locale: Locale = 'en';
const basePath = getLocalePath(locale);
const catName = getCategoryName(locale, cat.slug);
const displayName = getLiveProductName(product, locale);
const inquireMsg = encodeURIComponent(
  t(locale, 'whatsapp.detailMsg', {
    name: displayName,
    sku: product.firstSku,
    category: catName,
  }),
);
const inquireLink = `https://wa.me/${CONTACT.whatsapp}?text=${inquireMsg}`;
const colors = Array.from(new Set(product.variants.map((v) => v.colorClean).filter(Boolean)));
const sizes = Array.from(new Set(product.variants.map((v) => v.size).filter(Boolean)));
---

<Layout
  locale="en"
  title={`${product.seoTitle || displayName} (${product.firstSku}) | HiDREAM® Wholesale`}
  description={product.seoDescription || product.description || `${displayName} — ${catName}. Wholesale & OEM/ODM.`}
>
  <section class="mx-auto max-w-7xl px-4 py-8 md:px-8 md:py-12">
    <nav class="text-xs text-stone" aria-label="Breadcrumb">
      <a href={`${basePath}/`} class="hover:text-olive-dark">{t(locale, 'nav.home')}</a>
      <span class="mx-1.5">/</span>
      <a href={`${basePath}/products`} class="hover:text-olive-dark">{t(locale, 'nav.products')}</a>
      <span class="mx-1.5">/</span>
      <a href={`${basePath}/products/${category}`} class="hover:text-olive-dark">{catName}</a>
      <span class="mx-1.5">/</span>
      <span class="text-dark-brown">{displayName}</span>
    </nav>

    <div class="mt-6 grid gap-8 lg:grid-cols-2 lg:gap-12">
      <div>
        <div class="overflow-hidden rounded-3xl bg-milk-tea/30 shadow-soft">
          {product.gallery.length > 0 ? (
            <div class="grid gap-3 sm:grid-cols-2">
              {product.gallery.slice(0, 8).map((img, i) => (
                <img
                  src={img}
                  alt={`${displayName} view ${i + 1}`}
                  width="720"
                  height="900"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="aspect-[4/5] w-full object-cover"
                />
              ))}
            </div>
          ) : product.image ? (
            <img
              src={product.image}
              alt={displayName}
              width="720"
              height="900"
              loading="eager"
              decoding="async"
              class="aspect-[4/5] w-full object-cover"
            />
          ) : (
            <div class="flex aspect-[4/5] w-full items-center justify-center text-stone/40">
              No product image
            </div>
          )}
        </div>
      </div>

      <div>
        <span class="inline-flex items-center gap-2 rounded-full bg-olive/10 px-3 py-1 text-xs font-semibold text-olive-dark">
          {catName} · {cat.nameCn}
        </span>
        <h1 class="mt-4 font-display text-2xl font-bold leading-tight text-dark-brown md:text-3xl">
          {displayName}
        </h1>

        {product.firstSku && (
          <p class="mt-2 font-mono text-sm text-stone">
            {t(locale, 'product.sku')}: <span class="text-dark-brown">{product.firstSku}</span>
          </p>
        )}

        {product.description && (
          <p class="mt-4 whitespace-pre-line text-sm leading-relaxed text-stone md:text-base">
            {product.description}
          </p>
        )}

        {(colors.length > 0 || sizes.length > 0) && (
          <div class="mt-6 flex flex-wrap gap-5">
            {colors.length > 0 && (
              <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-stone">{t(locale, 'product.colors')}</p>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  {colors.map((color) => <span class="rounded-full bg-milk-tea/50 px-3 py-1 text-xs text-dark-brown">{color}</span>)}
                </div>
              </div>
            )}
            {sizes.length > 0 && (
              <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-stone">{t(locale, 'product.sizes')}</p>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  {sizes.map((size) => <span class="rounded-full bg-milk-tea/50 px-3 py-1 text-xs text-dark-brown">{size}</span>)}
                </div>
              </div>
            )}
          </div>
        )}

        {(product.moq || product.oem) && (
          <div class="mt-6 grid grid-cols-2 gap-3">
            {product.moq && <div class="rounded-2xl bg-milk-tea/30 p-4"><p class="text-xs text-stone">MOQ</p><p class="mt-1 font-semibold text-dark-brown">{product.moq}</p></div>}
            {product.oem && <div class="rounded-2xl bg-milk-tea/30 p-4"><p class="text-xs text-stone">OEM / ODM</p><p class="mt-1 font-semibold text-dark-brown">Available</p></div>}
          </div>
        )}

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href={inquireLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-2xl bg-green-500 px-7 py-3.5 text-sm font-semibold text-white shadow-soft transition-all hover:bg-green-600">
            {t(locale, 'action.inquireNow')}
          </a>
          <a href={`${basePath}/contact`} class="inline-flex items-center gap-2 rounded-2xl border border-milk-tea bg-cream px-7 py-3.5 text-sm font-semibold text-dark-brown transition-all hover:border-olive hover:text-olive-dark">
            {t(locale, 'action.emailInquiry')}
          </a>
        </div>
        <p class="mt-3 text-xs text-stone">{t(locale, 'product.priceNote')}</p>
      </div>
    </div>

    {product.variants.length > 0 && (
      <div class="mt-12">
        <h2 class="font-display text-xl font-bold text-dark-brown md:text-2xl">{t(locale, 'product.specsTable')}</h2>
        <div class="mt-5 overflow-hidden rounded-3xl border border-milk-tea/60 shadow-card">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="bg-milk-tea/40 text-xs uppercase tracking-wide text-stone">
                <tr>
                  <th class="px-4 py-3 font-semibold">{t(locale, 'product.sku')}</th>
                  <th class="px-4 py-3 font-semibold">{t(locale, 'product.colors')}</th>
                  <th class="px-4 py-3 font-semibold">{t(locale, 'product.sizes')}</th>
                  <th class="px-4 py-3 font-semibold">Specs</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-milk-tea/50 bg-cream/40">
                {product.variants.map((variant) => (
                  <tr class="align-top transition-colors hover:bg-white/70">
                    <td class="px-4 py-3 font-mono text-dark-brown">{variant.sku}</td>
                    <td class="px-4 py-3 text-dark-brown">{variant.colorClean || '—'}</td>
                    <td class="px-4 py-3 text-dark-brown">{variant.size || '—'}</td>
                    <td class="px-4 py-3 whitespace-pre-line text-stone">{variant.specs || '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    )}

    {related.length > 0 && (
      <div class="mt-16">
        <div class="flex items-end justify-between">
          <h2 class="font-display text-xl font-bold text-dark-brown md:text-2xl">{t(locale, 'product.moreIn')} {catName}</h2>
          <a href={`${basePath}/products/${category}`} class="text-sm font-semibold text-olive-dark hover:text-caramel">{t(locale, 'action.viewAll')} →</a>
        </div>
        <div class="mt-6"><ProductGrid products={related} locale={locale} /></div>
      </div>
    )}
  </section>
</Layout>
