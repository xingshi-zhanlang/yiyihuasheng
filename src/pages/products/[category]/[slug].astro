---
import Layout from '../../../layouts/Layout.astro';
import ProductGrid from '../../../components/ProductGrid.astro';
import { getPublicProducts } from '../../../lib/catalog';
import { allProducts, getProductName, getVariantColor } from '../../../lib/products';
import { CATEGORIES, CONTACT } from '../../../consts';
import { t, getLocalePath, getCategoryName, type Locale } from '../../../i18n/utils';

const locale: Locale = 'en';
const basePath = getLocalePath(locale);
const env = (Astro.locals.runtime?.env || {}) as { DB?: D1Database };
const { category, slug } = Astro.params;
const catalog = await getPublicProducts(env);
const product = catalog.find((item) => item.category === category && item.slug === slug) || allProducts.find((item) => item.category === category && item.slug === slug);
const cat = CATEGORIES.find((item) => item.slug === category) || CATEGORIES[0];
const displayName = product ? getProductName(product, locale) : 'Product not found';
const related = product ? catalog.filter((item) => item.category === category && item.variants.length > 0 && item.slug !== slug).slice(0, 4) : [];
const inquireMsg = product ? encodeURIComponent(t(locale, 'whatsapp.detailMsg', { name: displayName, sku: product.firstSku, category: getCategoryName(locale, cat.slug) })) : '';
const inquireLink = `https://wa.me/${CONTACT.whatsapp}?text=${inquireMsg}`;
const colors = product ? Array.from(new Set(product.variants.map((v) => v.colorClean).filter(Boolean))) : [];
const sizes = product ? Array.from(new Set(product.variants.map((v) => v.size).filter(Boolean))) : [];
function parseSpecs(specs: string) { return (specs || '').split('\n').map((line) => line.trim()).filter(Boolean); }
---

<Layout locale="en" noindex={!product} title={product ? `${displayName} (${product.firstSku}) | HiDREAM® Wholesale` : 'Product not found | HiDREAM®'} description={product?.description || 'HiDREAM pet travel gear wholesale and OEM/ODM.'}>
  <section class="mx-auto max-w-7xl px-4 py-8 md:px-8 md:py-12">
    {!product ? (
      <div class="rounded-3xl border border-milk-tea bg-white/70 p-10 text-center"><h1 class="font-display text-3xl font-bold text-dark-brown">Product not found</h1><a href={`${basePath}/products`} class="mt-5 inline-flex rounded-2xl bg-olive px-6 py-3 text-sm font-semibold text-cream">Browse products</a></div>
    ) : (
      <>
        <nav class="text-xs text-stone" aria-label="Breadcrumb"><a href={`${basePath}/`} class="hover:text-olive-dark">{t(locale, 'nav.home')}</a><span class="mx-1.5">/</span><a href={`${basePath}/products`} class="hover:text-olive-dark">{t(locale, 'nav.products')}</a><span class="mx-1.5">/</span><a href={`${basePath}/products/${category}`} class="hover:text-olive-dark">{getCategoryName(locale, cat.slug)}</a><span class="mx-1.5">/</span><span class="text-dark-brown">{displayName}</span></nav>
        <div class="mt-6 grid gap-8 lg:grid-cols-2 lg:gap-12">
          <div>
            <div class="overflow-hidden rounded-3xl bg-milk-tea/30 shadow-soft"><div id="gallery-main">{product.gallery.length > 0 ? product.gallery.map((img, i) => <img src={img} alt={`${displayName} view ${i + 1}`} width="720" height="900" class={`gallery-main aspect-[4/5] w-full object-cover ${i === 0 ? 'block' : 'hidden'}`} loading={i === 0 ? 'eager' : 'lazy'} data-index={i} />) : product.image ? <img src={product.image} alt={displayName} width="720" height="900" class="aspect-[4/5] w-full object-cover" loading="eager" /> : <div class="flex aspect-[4/5] items-center justify-center text-stone/40">No image</div>}</div></div>
            {product.gallery.length > 1 && <div class="mt-4 grid grid-cols-4 gap-3">{product.gallery.map((img, i) => <button type="button" class="overflow-hidden rounded-2xl border-2 border-milk-tea/50 bg-milk-tea/20 transition-colors hover:border-olive data-[active=true]:border-olive" data-active={i === 0 ? 'true' : 'false'} data-index={i}><img src={img} alt={`${displayName} thumbnail ${i + 1}`} width="200" height="250" class="aspect-[4/5] w-full object-cover" loading="lazy" /></button>)}</div>}
          </div>
          <div>
            <span class="inline-flex rounded-full bg-olive/10 px-3 py-1 text-xs font-semibold text-olive-dark">{getCategoryName(locale, cat.slug)} · {cat.nameCn}</span>
            <h1 class="mt-4 font-display text-2xl font-bold leading-tight text-dark-brown md:text-3xl">{displayName}</h1>
            {product.firstSku && <p class="mt-2 font-mono text-sm text-stone">{t(locale, 'product.sku')}: <span class="text-dark-brown">{product.firstSku}</span></p>}
            {product.description && <p class="mt-4 text-sm leading-relaxed text-stone md:text-base">{product.description}</p>}
            {(colors.length > 0 || sizes.length > 0) && <div class="mt-6 flex flex-wrap gap-5">{colors.length > 0 && <div><p class="text-xs font-semibold uppercase tracking-wide text-stone">{t(locale, 'product.colors')}</p><div class="mt-2 flex flex-wrap gap-1.5">{colors.map((color) => <span class="rounded-full bg-milk-tea/50 px-3 py-1 text-xs text-dark-brown">{color}</span>)}</div></div>}{sizes.length > 0 && <div><p class="text-xs font-semibold uppercase tracking-wide text-stone">{t(locale, 'product.sizes')}</p><div class="mt-2 flex flex-wrap gap-1.5">{sizes.map((size) => <span class="rounded-full bg-milk-tea/50 px-3 py-1 text-xs text-dark-brown">{size}</span>)}</div></div>}</div>}
            <div class="mt-7 flex flex-wrap gap-3"><button type="button" data-inquiry-add={JSON.stringify({ id: product.id, name: displayName, sku: product.firstSku, url: new URL(`${basePath}/products/${product.category}/${product.slug}`, Astro.site ?? 'https://hidream-pet.com').toString(), qty: 1 })} class="inline-flex items-center gap-2 rounded-2xl bg-olive px-7 py-3.5 text-sm font-semibold text-cream shadow-soft hover:bg-olive-dark">{locale === 'zh' ? '加入询盘' : 'Add to inquiry'}</button><a href={inquireLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-2xl bg-green-500 px-7 py-3.5 text-sm font-semibold text-white shadow-soft hover:bg-green-600">{t(locale, 'action.inquireNow')}</a><a href={`${basePath}/contact`} class="inline-flex items-center rounded-2xl border border-milk-tea bg-cream px-7 py-3.5 text-sm font-semibold text-dark-brown hover:border-olive">{t(locale, 'action.emailInquiry')}</a></div>
            <p class="mt-3 text-xs text-stone">{t(locale, 'product.priceNote')}</p>
          </div>
        </div>
        {product.variants.length > 0 && <div class="mt-12"><h2 class="font-display text-xl font-bold text-dark-brown md:text-2xl">{t(locale, 'product.specsTable')}</h2><div class="mt-5 overflow-hidden rounded-3xl border border-milk-tea/60 shadow-card"><div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead class="bg-milk-tea/40 text-xs uppercase tracking-wide text-stone"><tr><th class="px-4 py-3">{t(locale, 'product.sku')}</th><th class="px-4 py-3">{t(locale, 'product.colors')}</th><th class="px-4 py-3">{t(locale, 'product.sizes')}</th><th class="px-4 py-3">Specs</th></tr></thead><tbody class="divide-y divide-milk-tea/50 bg-cream/40">{product.variants.map((variant) => <tr class="align-top hover:bg-white/70"><td class="px-4 py-3 font-mono text-dark-brown">{variant.sku}</td><td class="px-4 py-3">{getVariantColor(variant, locale) || '—'}</td><td class="px-4 py-3">{variant.size || '—'}</td><td class="px-4 py-3 text-stone">{parseSpecs(variant.specs).map((line) => <div>{line}</div>)}</td></tr>)}</tbody></table></div></div></div>}
        {related.length > 0 && <div class="mt-16"><div class="flex items-end justify-between"><h2 class="font-display text-xl font-bold text-dark-brown md:text-2xl">{t(locale, 'product.moreIn')} {getCategoryName(locale, cat.slug)}</h2><a href={`${basePath}/products/${category}`} class="text-sm font-semibold text-olive-dark">{t(locale, 'action.viewAll')} →</a></div><div class="mt-6"><ProductGrid products={related} locale={locale} /></div></div>}
      </>
    )}
  </section>
</Layout>

<script>
  const mainImgs = document.querySelectorAll<HTMLImageElement>('.gallery-main');
  const thumbs = document.querySelectorAll<HTMLButtonElement>('[data-index]');
  thumbs.forEach((button) => button.addEventListener('click', () => { const index = button.getAttribute('data-index'); mainImgs.forEach((image) => { const active = image.getAttribute('data-index') === index; image.classList.toggle('hidden', !active); image.classList.toggle('block', active); }); thumbs.forEach((item) => item.setAttribute('data-active', 'false')); button.setAttribute('data-active', 'true'); }));
</script>
