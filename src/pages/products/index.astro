---
// 产品总览页：展示所有品类 + 全部产品
import Layout from '../../layouts/Layout.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { allProducts, getCategoriesWithCounts } from '../../lib/products';
import { t, getLocalePath, type Locale } from '../../i18n/utils';

const locale: Locale = 'en';
const basePath = getLocalePath(locale);

const cats = getCategoriesWithCounts();
// 全部产品（有变体的）
const products = allProducts.filter((p) => p.variants.length > 0);
---

<Layout
  locale="en"
  title={`All Products — HiDREAM® 宠生几何 | Pet Travel Gear Wholesale`}
  description="Browse the full HiDREAM catalog — pet carriers, harnesses, leashes, travel gear and functional accessories. 113+ SKUs across 5 collections. Wholesale & OEM/ODM."
>
  <!-- 页头 -->
  <section class="border-b border-milk-tea/60 bg-milk-tea/20">
    <div class="mx-auto max-w-7xl px-4 py-12 md:px-8 md:py-16">
      <nav class="text-xs text-stone" aria-label="Breadcrumb">
        <a href={`${basePath}/`} class="hover:text-olive-dark">{t(locale, 'nav.home')}</a>
        <span class="mx-1.5">/</span>
        <span class="text-dark-brown">{t(locale, 'nav.products')}</span>
      </nav>
      <h1 class="mt-3 font-display text-3xl font-bold text-dark-brown md:text-4xl lg:text-5xl">
        {t(locale, 'nav.products')}
      </h1>
      <p class="mt-3 max-w-2xl text-stone">
        {products.length} products across {cats.length} collections. Click any
        item for full specs, or inquire directly via WhatsApp.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-10 md:px-8 md:py-14">
    <!-- 品类导航 -->
    <div class="sticky top-[72px] z-30 -mx-4 mb-8 bg-cream/85 px-4 py-3 backdrop-blur md:mx-0 md:rounded-2xl md:px-4">
      <CategoryNav showAll={false} />
    </div>

    <ProductGrid products={products} eager={true} locale={locale} />
  </section>
</Layout>
