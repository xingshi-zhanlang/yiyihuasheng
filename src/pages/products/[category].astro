---
// 品类列表页：运行时从 EmDash D1 读取已发布产品
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { getLiveProductsByCategory } from '../../lib/live-products';
import { CATEGORIES } from '../../consts';
import { t, getLocalePath, getCategoryName, type Locale } from '../../i18n/utils';

const { category } = Astro.params;
const cat = CATEGORIES.find((c) => c.slug === category);
if (!cat) return new Response(null, { status: 404 });

const products = (await getLiveProductsByCategory(category!)).filter(
  (p) => p.variants.length > 0,
);

const locale: Locale = 'en';
const basePath = getLocalePath(locale);
const catName = getCategoryName(locale, cat.slug);
---

<Layout
  locale="en"
  title={`${catName} — ${cat.nameCn} | HiDREAM® Wholesale`}
  description={cat.description}
>
  <section class="border-b border-milk-tea/60 bg-milk-tea/20">
    <div class="mx-auto max-w-7xl px-4 py-12 md:px-8 md:py-16">
      <nav class="text-xs text-stone" aria-label="Breadcrumb">
        <a href={`${basePath}/`} class="hover:text-olive-dark">{t(locale, 'nav.home')}</a>
        <span class="mx-1.5">/</span>
        <a href={`${basePath}/products`} class="hover:text-olive-dark">{t(locale, 'nav.products')}</a>
        <span class="mx-1.5">/</span>
        <span class="text-dark-brown">{catName}</span>
      </nav>
      <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="font-rounded text-sm font-semibold uppercase tracking-[0.2em] text-caramel">
            {cat.tagline}
          </p>
          <h1 class="mt-2 font-display text-3xl font-bold text-dark-brown md:text-4xl lg:text-5xl">
            {catName}
          </h1>
          <p class="mt-1 text-sm text-stone">{cat.nameCn} · {products.length} products</p>
        </div>
      </div>
      <p class="mt-4 max-w-2xl text-stone">{cat.description}</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-10 md:px-8 md:py-14">
    <div class="sticky top-[72px] z-30 -mx-4 mb-8 bg-cream/85 px-4 py-3 backdrop-blur md:mx-0 md:rounded-2xl md:px-4">
      <CategoryNav active={category} />
    </div>

    {products.length > 0 ? (
      <ProductGrid products={products} eager={true} locale={locale} />
    ) : (
      <div class="rounded-3xl border border-milk-tea/60 bg-white/40 px-6 py-16 text-center text-stone">
        Products are being updated. Please contact us for the latest catalog.
      </div>
    )}
  </section>
</Layout>
