---
import Layout from '../../layouts/Layout.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { getPublicProducts, getPublicProductsByCategory } from '../../lib/catalog';
import { CATEGORIES } from '../../consts';
import { t, getLocalePath, getCategoryName, type Locale } from '../../i18n/utils';

const locale: Locale = 'en';
const basePath = getLocalePath(locale);
const env = (Astro.locals.runtime?.env || {}) as { DB?: D1Database };
const { category } = Astro.params;
const cat = CATEGORIES.find((c) => c.slug === category) || CATEGORIES[0];
const all = await getPublicProducts(env);
const products = getPublicProductsByCategory(all, category || '').filter((p) => p.variants.length > 0);
const catName = getCategoryName(locale, cat.slug);
---

<Layout locale="en" title={`${catName} — ${cat.nameCn} | HiDREAM® Wholesale`} description={cat.description}>
  <section class="border-b border-milk-tea/60 bg-milk-tea/20"><div class="mx-auto max-w-7xl px-4 py-12 md:px-8 md:py-16"><nav class="text-xs text-stone" aria-label="Breadcrumb"><a href={`${basePath}/`} class="hover:text-olive-dark">{t(locale, 'nav.home')}</a><span class="mx-1.5">/</span><a href={`${basePath}/products`} class="hover:text-olive-dark">{t(locale, 'nav.products')}</a><span class="mx-1.5">/</span><span class="text-dark-brown">{catName}</span></nav><div class="mt-3 flex flex-wrap items-end justify-between gap-4"><div><p class="font-rounded text-sm font-semibold uppercase tracking-[0.2em] text-caramel">{cat.tagline}</p><h1 class="mt-2 font-display text-3xl font-bold text-dark-brown md:text-4xl lg:text-5xl">{catName}</h1><p class="mt-1 text-sm text-stone">{cat.nameCn} · {products.length} products</p></div></div><p class="mt-4 max-w-2xl text-stone">{cat.description}</p></div></section>
  <section class="mx-auto max-w-7xl px-4 py-10 md:px-8 md:py-14"><div class="sticky top-[72px] z-30 -mx-4 mb-8 bg-cream/85 px-4 py-3 backdrop-blur md:mx-0 md:rounded-2xl md:px-4"><CategoryNav active={category} /></div><ProductGrid products={products} eager={true} locale={locale} /></section>
</Layout>
