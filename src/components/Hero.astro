---
// 首页 Hero：可通过 CMS 修改文案与两张主视觉图。
import { Image } from 'astro:assets';
import { CONTACT } from '../consts';
import { getProductsByCategory } from '../lib/products';
import siteHome from '../data/site-home.json';
import { t, getLocalePath, type Locale } from '../i18n/utils';

interface Props {
  locale?: Locale;
}
const locale: Locale = Astro.props.locale || 'en';
const basePath = getLocalePath(locale);

const newArrivals = getProductsByCategory('new-arrivals').filter((p) => p.variants.length > 0);
const fallback1 = newArrivals[0]?.image || null;
const fallback2 = newArrivals[1]?.image || fallback1;
const quoteLink = `https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(t(locale, 'whatsapp.defaultMsg'))}`;
const hero1 = siteHome.heroImage1 || fallback1;
const hero2 = siteHome.heroImage2 || fallback2;
---

<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -left-24 -top-24 h-96 w-96 rounded-full bg-olive/10 blur-3xl"></div>
    <div class="absolute -right-20 top-40 h-80 w-80 rounded-full bg-caramel/10 blur-3xl"></div>
    <div class="absolute bottom-0 left-1/3 h-72 w-72 rounded-full bg-milk-tea/30 blur-3xl"></div>
  </div>

  <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-16 md:px-8 md:py-24 lg:grid-cols-2 lg:gap-12 lg:py-28">
    <div class="animate-fade-up">
      <span class="inline-flex items-center gap-2 rounded-full border border-olive/20 bg-olive/5 px-4 py-1.5 text-xs font-semibold tracking-wide text-olive-dark">
        <span class="h-1.5 w-1.5 rounded-full bg-caramel"></span>
        {locale === 'en' ? siteHome.heroBadge : t(locale, 'hero.badge')}
      </span>

      <h1 class="mt-5 font-display text-4xl font-bold leading-tight text-dark-brown md:text-5xl lg:text-6xl">
        {locale === 'en' ? siteHome.heroTitle : t(locale, 'hero.title1')}<br />
        <span class="text-olive">{locale === 'en' ? siteHome.heroHighlight : t(locale, 'hero.title2')}</span>
      </h1>

      <p class="mt-3 font-rounded text-lg text-caramel md:text-xl">
        {locale === 'en' ? siteHome.heroSubtitle : t(locale, 'hero.subtitle')}
      </p>

      <p class="mt-5 max-w-xl text-base leading-relaxed text-stone md:text-lg">
        {locale === 'en' ? siteHome.heroDescription : t(locale, 'hero.description')}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={basePath + '/products'} class="inline-flex items-center gap-2 rounded-full bg-olive px-7 py-3.5 text-sm font-semibold text-cream shadow-soft transition-all hover:bg-olive-dark hover:shadow-hover">
          {t(locale, 'action.browseProducts')}
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a href={quoteLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border border-caramel bg-cream px-7 py-3.5 text-sm font-semibold text-caramel transition-all hover:bg-caramel hover:text-cream">
          {t(locale, 'action.getQuote')}
        </a>
      </div>

      <dl class="mt-10 grid grid-cols-3 gap-4 border-t border-milk-tea/60 pt-6">
        <div><dt class="font-display text-2xl font-bold text-olive-dark">113+</dt><dd class="mt-1 text-xs text-stone">{t(locale, 'hero.statSkus')}</dd></div>
        <div><dt class="font-display text-2xl font-bold text-olive-dark">5</dt><dd class="mt-1 text-xs text-stone">{t(locale, 'hero.statLines')}</dd></div>
        <div><dt class="font-display text-2xl font-bold text-olive-dark">OEM/ODM</dt><dd class="mt-1 text-xs text-stone">{t(locale, 'hero.statOem')}</dd></div>
      </dl>
    </div>

    <div class="relative animate-fade-up [animation-delay:150ms]">
      <div class="relative grid grid-cols-2 gap-4">
        <div class="overflow-hidden rounded-3xl shadow-soft">
          {typeof hero1 === 'string' ? (
            <img src={hero1} alt="HiDREAM pet carrier" width="560" height="700" class="h-full w-full object-cover" loading="eager" decoding="async" />
          ) : hero1 ? (
            <Image src={hero1} alt="HiDREAM pet carrier" width={560} height={700} class="h-full w-full object-cover" loading="eager" format="webp" quality={85} />
          ) : null}
        </div>
        <div class="mt-10 overflow-hidden rounded-3xl shadow-soft">
          {typeof hero2 === 'string' ? (
            <img src={hero2} alt="HiDREAM pet product" width="560" height="700" class="h-full w-full object-cover" loading="eager" decoding="async" />
          ) : hero2 ? (
            <Image src={hero2} alt="HiDREAM pet product" width={560} height={700} class="h-full w-full object-cover" loading="eager" format="webp" quality={85} />
          ) : null}
        </div>
      </div>

      <div class="absolute -bottom-5 left-1/2 -translate-x-1/2 rounded-2xl bg-cream/95 px-5 py-3 shadow-card backdrop-blur md:left-6 md:translate-x-0">
        <div class="flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-olive/10 text-olive">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path><path d="M2 21c0-3 1.85-5.36 5.08-6"></path></svg>
          </span>
          <div class="leading-tight">
            <p class="text-sm font-semibold text-dark-brown">{t(locale, 'hero.badgeValley')}</p>
            <p class="text-xs text-stone">{t(locale, 'hero.badgeEco')}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
