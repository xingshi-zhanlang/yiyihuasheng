---
// 固定 WhatsApp 按钮；询盘购物车位于更靠近底部的位置，避免遮挡。
import { CONTACT } from '../consts';
import { t, type Locale } from '../i18n/utils';

interface Props { locale?: Locale; }
const locale: Locale = Astro.props.locale || 'en';
const waLink = `https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(t(locale, 'whatsapp.defaultMsg'))}`;
---

<a
  href={waLink}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat on WhatsApp"
  class="group fixed bottom-24 right-5 z-50 flex items-center gap-3 rounded-full bg-green-500 px-4 py-4 text-white shadow-soft transition-all hover:bg-green-600 hover:shadow-hover animate-wa-pulse md:bottom-24 md:px-5"
>
  <svg class="h-7 w-7 md:h-8 md:w-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.515 5.26l-.999 3.648 3.973-1.041z" />
  </svg>
  <span class="hidden font-semibold tracking-wide md:inline">WhatsApp</span>
</a>
