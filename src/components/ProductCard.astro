---
// 产品卡片：图片 + 名称 + SKU + 品类标签 + 询价按钮
import { Image } from 'astro:assets';
import type { Product } from '../lib/products';
import { getProductName } from '../lib/products';
import { CATEGORIES, CONTACT } from '../consts';
import { t, getLocalePath, getCategoryName, type Locale } from '../i18n/utils';

interface Props {
  product: Product;
  eager?: boolean;
  locale?: Locale;
}

const { product, eager = false, locale = 'en' } = Astro.props;
const basePath = getLocalePath(locale);

const cat = CATEGORIES.find((c) => c.slug === product.category);
const detailLink = `${basePath}/products/${product.category}/${product.slug}`;
const displayName = getProductName(product, locale);

const inquireMsg = t(locale, 'whatsapp.productMsg', { name: displayName, sku: product.firstSku });
const inquireLink = `https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(inquireMsg)}`;
---

<article
  class="group relative flex flex-col overflow-hidden rounded-3xl border border-milk-tea/50 bg-white/70 shadow-card transition-all duration-300 hover:-translate-y-1.5 hover:shadow-hover"
>
  <a href={detailLink} class="relative block aspect-[4/5] overflow-hidden bg-milk-tea/30" aria-label={displayName}>
    {product.image ? (
      <Image
        src={product.image}
        alt={displayName}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        width={640}
        height={800}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        format="webp"
        quality={80}
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center text-stone/40">
        <svg class="h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
      </div>
    )}
    {cat && (
      <span class="absolute left-3 top-3 rounded-full bg-cream/90 px-3 py-1 text-[11px] font-semibold tracking-wide text-olive-dark backdrop-blur">
        {getCategoryName(locale, cat.slug)}
      </span>
    )}
  </a>

  <div class="flex flex-1 flex-col p-4 md:p-5">
    <h3 class="line-clamp-2 font-medium leading-snug text-dark-brown">
      <a href={detailLink} class="transition-colors hover:text-olive">
        {displayName}
      </a>
    </h3>

    <div class="mt-2 flex items-center gap-2 text-xs text-stone">
      <span class="rounded-md bg-milk-tea/40 px-2 py-0.5 font-mono">
        {product.firstSku}
      </span>
      {product.variants.length > 1 && (
        <span>{product.variants.length} {t(locale, 'product.variants')}</span>
      )}
    </div>

    <div class="mt-4 flex items-center gap-2 pt-1">
      <a
        href={inquireLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex flex-1 items-center justify-center gap-1.5 rounded-2xl bg-olive px-4 py-2.5 text-sm font-semibold text-cream transition-colors hover:bg-olive-dark"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.515 5.26l-.999 3.648 3.973-1.041zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"></path></svg>
        {t(locale, 'action.inquire')}
      </a>
      <a
        href={detailLink}
        class="inline-flex items-center justify-center rounded-2xl border border-milk-tea px-3 py-2.5 text-sm font-medium text-stone transition-colors hover:border-olive hover:text-olive-dark"
        aria-label={t(locale, 'action.viewDetails')}
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
      </a>
    </div>
  </div>
</article>
